<div class="max-w-5xl mx-auto p-6">
  <h1 class="text-3xl font-bold mb-6">Filter Events</h1>

  <form
    hx-get="/events/filter"
    hx-target="#filter-results"
    hx-swap="innerHTML"
    class="flex flex-wrap gap-4 items-end mb-6"
  >
    <div>
      <label for="category" class="block font-semibold mb-1">
        Category
      </label>

      <select
        name="category"
        id="category"
        class="border rounded-lg px-4 py-2 min-w-44 shadow-sm"
      >
        <option value="">All Categories</option>
        <option value="social">Social</option>
        <option value="educational">Educational</option>
        <option value="volunteer">Volunteer</option>
        <option value="sports">Sports</option>
        <option value="arts">Arts</option>
      </select>
    </div>

    <div>
      <label for="startDatetime" class="block font-semibold mb-1">
        From
      </label>

      <input
        type="datetime-local"
        name="startDatetime"
        id="startDatetime"
        class="border rounded-lg px-4 py-2 shadow-sm"
      >
    </div>

    <div>
      <label for="endDatetime" class="block font-semibold mb-1">
        To
      </label>

      <input
        type="datetime-local"
        name="endDatetime"
        id="endDatetime"
        class="border rounded-lg px-4 py-2 shadow-sm"
      >
    </div>

    <button
      type="submit"
      class="bg-blue-600 text-white px-5 py-2 rounded-lg hover:bg-blue-700 transition"
    >
      Filter
    </button>
  </form>

  <div class="border-t pt-4">
    <div id="filter-results">
      <%- include('../partials/filter-results', { events: events }) %>
    </div>
  </div>
</div>