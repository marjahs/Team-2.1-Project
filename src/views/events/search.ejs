<div class="max-w-4xl mx-auto p-6">
  <h1 class="text-3xl font-bold mb-6">Event Search</h1>

  <form
    hx-get="/events/search"
    hx-target="#search-results"
    hx-swap="innerHTML"
    class="flex gap-4 items-center mb-6"
  >
    <input
      type="text"
      name="q"
      value="<%= query %>"
      placeholder="Search title, location, category, or description..."
      class="border rounded-lg px-4 py-2 w-96 shadow-sm"
      hx-get="/events/search"
      hx-trigger="keyup changed delay:400ms"
      hx-target="#search-results"
      hx-swap="innerHTML"
    />

    <button
      type="submit"
      class="bg-blue-600 text-white px-5 py-2 rounded-lg hover:bg-blue-700 transition"
    >
      Search
    </button>
  </form>

  <div class="border-t pt-4">
    <div id="search-results">
      <%- include('../partials/search-results', { events: events }) %>
    </div>
  </div>
</div>