<div class="max-w-xl mx-auto bg-white p-6 rounded-xl shadow">

  <h1 class="text-2xl font-bold mb-4">Create Event</h1>

  <form method="POST" action="/events" class="space-y-4">

    <!-- Title -->
    <input 
      name="title"
      placeholder="Event Title"
      class="w-full border p-2 rounded focus:outline-none focus:ring-2 focus:ring-indigo-400"
    />

    <!-- Description with Alpine -->
    <div x-data="{ count: 0 }" class="space-y-1">
      <textarea 
        name="description"
        placeholder="Event Description"
        maxlength="500"
        x-on:input="count = $event.target.value.length"
        class="w-full border p-2 rounded focus:outline-none focus:ring-2 focus:ring-indigo-400"
      ></textarea>

      <p class="text-sm text-gray-500">
        <span x-text="count"></span> / 500 characters
      </p>
    </div>

    <!-- Location -->
    <input 
      name="location"
      placeholder="Location"
      class="w-full border p-2 rounded focus:outline-none focus:ring-2 focus:ring-indigo-400"
    />

    <!-- Category -->
    <input 
      name="category"
      placeholder="Category"
      class="w-full border p-2 rounded focus:outline-none focus:ring-2 focus:ring-indigo-400"
    />

    <!-- Submit -->
    <button 
      type="submit"
      class="w-full bg-indigo-600 text-white py-2 rounded hover:bg-indigo-700 transition"
    >
      Create Event
    </button>

  </form>

</div>