<div class="max-w-3xl mx-auto bg-white p-6 rounded-xl shadow">
  <h1 class="text-3xl font-bold mb-4"><%= event.title %></h1>
  <p class="text-gray-500 mb-1"><%= event.location %></p>
  <p class="text-gray-500 mb-4">🏷️ <%= event.category %></p>
  <div class="bg-gray-100 p-4 rounded-lg mb-6">
    <p><%= event.description %></p>
  </div>
  <div class="flex gap-4 mb-6">
    <button class="bg-indigo-600 text-white px-4 py-2 rounded hover:bg-indigo-700 transition">
      Save for Later
    </button>
    <button class="bg-green-600 text-white px-4 py-2 rounded hover:bg-green-700 transition">
      RSVP
    </button>
  </div>
</div>

<%- include("../partials/event-actions", { event, session }) %>

<%# --- Attendee list button (Feature 12, organizer/admin only) --- %>
<% const isOrganizer = session.authenticatedUser?.userId === event.organizerId %>
<% const isAdmin = session.authenticatedUser?.role === 'admin' %>
<% if (isOrganizer || isAdmin) { %>
  <div class="mt-6" x-data="{ open: false }">
    <button
      x-on:click="open = !open; if (open) { htmx.trigger($el, 'loadAttendees'); }"
      hx-get="/events/<%= event.id %>/attendees"
      hx-target="#attendee-panel"
      hx-swap="innerHTML"
      hx-trigger="loadAttendees"
      class="flex items-center gap-2 px-4 py-2 rounded-lg bg-blue-600 text-white font-medium hover:bg-blue-700 transition-colors cursor-pointer">
      <span x-text="open ? 'Hide Attendees' : 'View Attendees'">View Attendees</span>
      <svg x-bind:class="open ? 'rotate-180' : ''"
           class="w-4 h-4 transition-transform duration-200"
           fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
      </svg>
    </button>
    <div id="attendee-panel"
         x-show="open"
         x-transition:enter="transition ease-out duration-200"
         x-transition:enter-start="opacity-0 translate-y-1"
         x-transition:enter-end="opacity-100 translate-y-0"
         x-transition:leave="transition ease-in duration-150"
         x-transition:leave-start="opacity-100 translate-y-0"
         x-transition:leave-end="opacity-0 translate-y-1"
         class="mt-3 p-4 bg-white rounded-xl border border-slate-200 shadow-sm">
    </div>
  </div>
<% } %>

<%# --- Comments (Feature 13) --- %>
<%- include('../partials/comments', { comments: comments ?? [], eventId: event.id, currentUserId: session.authenticatedUser?.userId, userRole: session.authenticatedUser?.role }) %>
